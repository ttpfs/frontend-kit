{
	"devDependencies": {
		"@biomejs/biome": "2.4.10",
		"@turbo/gen": "^2.8.0",
		"@types/node": "^24.12.0",
		"tsx": "^4.21.0",
		"turbo": "^2.9.3",
		"typescript": "5.9.2"
	},
	"engines": {
		"node": ">=20"
	},
	"name": "frontend-kit",
	"packageManager": "pnpm@9.0.0",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "turbo run dev",
		"format:fix": "pnpx @biomejs/biome check --write .",
		"lint": "pnpx @biomejs/biome lint .",
		"lint:fix": "pnpx @biomejs/biome lint --write .",
		"release": "pnpm install && pnpm build && pnpm --filter=./packages/* publish --no-git-checks",
		"storybook": "pnpm --filter=./apps/* storybook",
		"sync:readme": "tsx scripts/generate-readme-packages.ts"
	}
}
