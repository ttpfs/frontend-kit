	"dependencies": {
		"@heroui/react": "3.0.1",
		"@heroui/styles": "3.0.1",
		"class-variance-authority": "^0.7.1",
		"date-fns": "4.1.0",
		"next-themes": "0.4.6",
		"radix-ui": "1.4.3",
		"react-medium-image-zoom": "5.4.0",
		"tw-animate-css": "1.4.0"
	},
	"description": "A UI component library built on top of HeroUI, providing simplified and ergonomic APIs over complex compound components. It standardizes common patterns (Drawer, Modal, AlertDialog, Popover) and includes a theme system powered by next-themes using class-based switching. The library also introduces a type-safe icon system with registry support via Iconify.",
	"devDependencies": {
		"@packages/typescript-config": "workspace:*",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"tsup": "^8.5.1",
		"typescript": "5.9.2"
	},
	"exports": {
		".": {
			"import": "./dist/index.js",
			"types": "./dist/index.d.ts"
		},
		"./*": null,
		"./styles.css": "./dist/styles.css"
	},
	"files": [
		"dist"
	],
	"homepage": "https://github.com/ttpfs/frontend-kit/tree/main/packages/ui#readme",
	"keywords": [
		"ui",
		"typescript",
		"heroui"
	],
	"license": "MIT",
	"main": "./dist/index.js",
	"name": "@ttpfs/ui-react",
	"peerDependencies": {
		"@iconify-json/logos": "^1.2.10",
		"@iconify-json/lucide": "^1.2.86",
		"@iconify-json/svg-spinners": "^1.2.4",
		"@iconify/tailwind4": "^1.2.1",
		"react": "^19",
		"react-dom": "^19",
		"tailwindcss": "^4"
	},
	"publishConfig": {
		"registry": "https://npm.pkg.github.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/ttpfs/frontend-kit.git"
	},
	"scripts": {
		"build": "tsup && cp src/styles.css dist/styles.css"
	},
	"sideEffects": [
		"*.css"
	],
	"style": "./dist/global.css",
	"type": "module",
	"types": "./dist/index.d.ts",
	"version": "1.4.3"
}
